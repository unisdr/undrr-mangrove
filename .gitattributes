# Auto detect text files and perform LF normalization
* text=auto

# A digest manifest cannot be line-merged. Git will happily combine hashes
# from both sides without conflicting, producing a baseline that describes
# neither branch and that nobody is prompted to regenerate. Force a conflict
# instead; see the $comment in the file for how to resolve one.
tokens/output-baseline.json -merge

# Preserve exact source bytes pinned by the Figma draft asset guard.
examples/figma-plugin/holistic/assets/page-chrome/undrr-logo-horizontal.svg -text

# Raw unified diff evidence uses a required context marker on blank lines.
examples/figma-plugin/holistic/assets/content-hub/generated-css-additions.diff -text whitespace=-blank-at-eol

# Preserve exact HTTP status, CRLF and header terminator bytes of this evidence.
examples/figma-plugin/holistic/assets/footer/widget-body-direct-http.headers -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Preserve the exact downloaded PageHeader logo response bytes, including CRLF.
examples/figma-plugin/holistic/assets/page-header/http-bodies/undrr-logo-horizontal.svg -text whitespace=cr-at-eol

