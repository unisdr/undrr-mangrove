  "border-color": {
    "button": {
      "$type": "color",
      "$value": "{color.text-button}",
      "$description": "Must be a colour, not a channel triplet: it is consumed inside a `border:` shorthand, and a bare triplet makes the whole declaration invalid, which silently drops border-style to none. .mg-button-outline rendered as bare text for the entire time this was a triplet."
    },
    "button-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0
      },
      "$description": "Stroke on filled primary buttons. The fill is painted under the border, so `transparent` makes the stroke match the fill and keeps filled and outline buttons the same size. A theme can set a colour here (for example a darker shade of the fill) to give filled buttons a visible edge."
    },
    "button-secondary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0
      },
      "$description": "Stroke on filled secondary buttons. See border-color.button-primary."
    },
    "hero-button-secondary": {
