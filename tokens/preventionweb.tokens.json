{
  "$extensions": {
    "org.undrr.mangrove": {
      "brand": {
        "id": "preventionweb",
        "extends": "undrr",
        "title": "PreventionWeb",
        "selector": ".mg-theme-preventionweb"
      }
    }
  },
  "theme": {
    "loaded": {
      "$description": "Runtime marker: lets JS and tooling detect that this brand theme is active, guarding the sub-brand body-class trap. See docs/RELEASE-2.0.md.",
      "$extensions": {
        "org.undrr.mangrove": {
          "output": {
            "value": "preventionweb",
            "type": "string"
          }
        }
      }
    }
  },
  "brand": {
    "$extensions": {
      "org.undrr.mangrove": {
        "private": true
      }
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.0392156862745098, 0.4117647058823529, 0.4117647058823529
        ]
      },
      "$description": "PreventionWeb teal. The one primitive this brand states."
    },
    "teal-800": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.047058823529411764, 0.4588235294117647, 0.4588235294117647
        ]
      },
      "$description": "Lighter partner of the brand teal. Carries the secondary button fill and, since the primary button's hover left the orange accent, that hover too. White on it is 5.5:1 and 69.7 perceptually, so it clears AA either way, and it sits 4.2 dE2000 from the brand teal \u2014 comfortably past the ~2.3 just-noticeable difference, though a shallower step than the base theme's own blue-900 to blue-700 hover (12.2)."
    }
  },
  "color": {
    "interactive": {
      "$type": "color",
      "$value": "{brand.primary}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "interactive-active": {
      "$type": "color",
      "$value": "{brand.primary}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "tag": {
      "$type": "color",
      "$value": "{color.interactive}"
    },
    "tag--hover": {
      "$type": "color",
      "$value": "{color.interactive-active}"
    },
    "button-background": {
      "$type": "color",
      "$value": "{color.interactive}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function",
          "resolve": "literal"
        }
      }
    },
    "button-background--hover": {
      "$type": "color",
      "$value": "{brand.teal-800}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function",
          "resolve": "literal"
        }
      }
    },
    "button-secondary-background": {
      "$type": "color",
      "$value": "{brand.teal-800}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "button-secondary-background--hover": {
      "$type": "color",
      "$value": "{brand.primary}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "button-outline-primary": {
      "$type": "color",
      "$value": "{color.interactive}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "button-outline-primary--hover": {
      "$type": "color",
      "$value": "{brand.teal-800}",
      "$extensions": {
        "org.undrr.mangrove": {
          "resolve": "literal"
        }
      }
    },
    "button-outline-secondary": {
      "$type": "color",
      "$value": "{color.button-secondary-background}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "literal"
        }
      }
    },
    "button-outline-secondary--hover": {
      "$type": "color",
      "$value": "{color.button-secondary-background--hover}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "literal"
        }
      }
    },
    "form-check": {
      "$type": "color",
      "$value": "{color.interactive}"
    },
    "form-check--hover": {
      "$type": "color",
      "$value": "{color.interactive-active}"
    },
    "form-check--checked": {
      "$type": "color",
      "$value": "{color.interactive}"
    },
    "form-focus": {
      "$type": "color",
      "$value": "{color.interactive}"
    },
    "hero": {
      "$type": "color",
      "$value": "{color.interactive}"
    },
    "tabbar-background": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          {
            "$ref": "#/color/interactive/$value/components/0"
          },
          {
            "$ref": "#/color/interactive/$value/components/1"
          },
          {
            "$ref": "#/color/interactive/$value/components/2"
          }
        ],
        "alpha": 0.1
      },
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function",
          "resolve": "literal"
        }
      }
    },
    "tab-background": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          {
            "$ref": "#/color/interactive/$value/components/0"
          },
          {
            "$ref": "#/color/interactive/$value/components/1"
          },
          {
            "$ref": "#/color/interactive/$value/components/2"
          }
        ],
        "alpha": 0.1
      },
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function",
          "resolve": "literal"
        }
      }
    },
    "tab-background--inactive": {
      "$type": "color",
      "$value": "{color.tabbar-background}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "literal"
        }
      }
    },
    "tab-background--hover": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          {
            "$ref": "#/color/interactive/$value/components/0"
          },
          {
            "$ref": "#/color/interactive/$value/components/1"
          },
          {
            "$ref": "#/color/interactive/$value/components/2"
          }
        ],
        "alpha": 0.2
      },
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function",
          "resolve": "literal"
        }
      }
    },
    "tab-border": {
      "$type": "color",
      "$value": "{color.interactive}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    },
    "tab-border--hover": {
      "$type": "color",
      "$value": "{color.interactive}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    },
    "tab-border--active": {
      "$type": "color",
      "$value": "{color.tab-background}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "literal"
        }
      }
    },
    "text-tab": {
      "$type": "color",
      "$value": "{color.neutral-700}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    },
    "text-tab--hover": {
      "$type": "color",
      "$value": "{color.neutral-700}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    },
    "text-tab-active": {
      "$type": "color",
      "$value": "{color.neutral-900}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    }
  },
  "notice": {
    "action-secondary": {
      "$type": "color",
      "$value": "{color.button-outline-secondary}",
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "srgb-rgb-function"
        }
      }
    }
  },
  "radius": {
    "button": {
      "$type": "dimension",
      "$value": "{spacing.50}"
    },
    "tab": {
      "$extensions": {
        "org.undrr.mangrove": {
          "output": {
            "value": "{spacing.50} {spacing.50} 0 0",
            "type": "dimension"
          }
        }
      }
    }
  },
  "spacing": {
    "hero-overlay": {
      "$extensions": {
        "org.undrr.mangrove": {
          "format": "literal",
          "output": {
            "value": "{=spacing.200} 0",
            "type": "dimension",
            "format": "literal"
          }
        }
      }
    }
  },
  "$description": "DTCG 2025.10 token data. Mangrove output conventions are namespaced extensions. CSS-only group output recipes are not portable design tokens."
}
